{
  "name": "phy622x",
  "title": "PhyPlus phy622x",
  "description": "PhyPlus phy622x Cortex-M0 platform",
  "homepage": "http://en.phyplusinc.com/product_detail/1.html",
  "license": "Apache-2.0",
  "keywords": [
    "dev-platform",
    "ARM",
    "Cortex-M",
    "PhyPlus",
    "phy6222",
    "phy622x"
  ],
  "engines": {
    "platformio": "^6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cocus/platform-phy622x.git"
  },
  "version": "19.2.0",
  "frameworks": {
    "phy622x": {
      "package": "framework-phy622x",
      "script": "builder/frameworks/no-osal.py",
      "description": "This is a custom set of drivers (HAL) that make this target look like a STM32, BLE doesn't work.",
      "homepage": "http://github.com/cocus/",
      "title": "No OSAL"
    }
  },
  "packages": {
    "toolchain-gccarmnoneeabi": {
      "type": "toolchain",
      "owner": "platformio",
      "version": ">=1.60301.0,<1.80000.0",
      "optionalVersions": [
        "~1.60301.0",
        "~1.80201.0",
        "~1.90201.0",
        "~1.120301.0"
      ]
    },
    "framework-phy622x": {
      "type": "framework",
      "optional": false,
      "version": "~0.0.1"
    },
    "tool-openocd": {
      "type": "uploader",
      "optional": true,
      "owner": "platformio",
      "version": "~3.1200.0"
    },
    "tool-gperf": {
      "optional": true,
      "owner": "platformio",
      "version": "^3.0.0"
    }
  }
}
